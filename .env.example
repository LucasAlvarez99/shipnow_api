PORT=3000
MONGODB_URI=
NODE_ENV=development
# Nivel de logs (Módulo 8): fatal | error | warning | info | http | debug
# En desarrollo se recomienda "debug" (se ve todo, incluidos los detalles
# internos); en producción, "info" (se omiten debug y http para no
# saturar los logs). Ver src/config/logger.config.js.
LOG_LEVEL=debug
