node_modules/
.env
.env.test
.env.docker

# Cobertura de tests, si se llega a generar
coverage/

# Logs generados por Winston (la carpeta se documenta, los archivos no se versionan)
logs/*.log
logs/*.log.gz
logs/.*-audit.json

# Archivos subidos por los usuarios (Módulo 7): la estructura de carpetas
# se versiona (vía .gitkeep) para que quede documentada, pero el contenido
# subido nunca va al repo.
uploads/documentos-usuario/*
!uploads/documentos-usuario/.gitkeep
uploads/comprobantes-entrega/*
!uploads/comprobantes-entrega/.gitkeep
