PORT=3001
# IMPORTANTE: debe ser una base DISTINTA a la de desarrollo (usada solo por
# los tests, se limpia automáticamente después de cada test). El nombre de
# la base debe contener "test": setup.js lo valida como red de seguridad
# para evitar borrar datos reales por error.
MONGODB_URI=mongodb://127.0.0.1:27017/shipnow_test
NODE_ENV=test
