PORT=3001
# IMPORTANTE: debe ser una base DISTINTA a la de desarrollo (usada solo por
# los tests, se limpia automáticamente después de cada test). El nombre de
# la base debe contener "test": setup.js lo valida como red de seguridad
# para evitar borrar datos reales por error. Este valor por defecto ya
# apunta a una base de testing válida en un MongoDB local corriendo en el
# puerto por defecto (27017); si tu Mongo corre en otro host/puerto,
# ajustalo acá.
MONGODB_URI=mongodb://127.0.0.1:27017/shipnow_test
NODE_ENV=test
# Nivel de logs (Módulo 8): igual que en .env.example. En testing se
# recomienda "warning" para no ensuciar la salida de `npm test` con logs
# de info/debug/http de cada request, pero sí ver advertencias reales.
LOG_LEVEL=warning
